{
  "name": "MADAR Delivery Reconciliation",
  "nodes": [
    {
      "id": "schedule",
      "name": "Review provider outcomes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "escalate-uncertain-and-failed-delivery",
      "name": "Escalate uncertain and failed delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/bridge/reconcile",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "MADAR bridge"
        }
      }
    },
    {
      "id": "incidents-need-operator-review",
      "name": "Incidents need operator review",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.open_incidents > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "return-reconciliation-queue",
      "name": "Return reconciliation queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        220
      ],
      "parameters": {
        "jsCode": "return [{json:{open_incidents:$json.open_incidents,new_incidents:$json.incidents_created,next_action:'Review dashboard incidents; reconcile provider outcome before retry'}}];"
      }
    },
    {
      "id": "return-clean-delivery-review",
      "name": "Return clean delivery review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        480
      ],
      "parameters": {
        "jsCode": "return [{json:{open_incidents:0,next_action:'No reconciliation required'}}];"
      }
    }
  ],
  "connections": {
    "Review provider outcomes": {
      "main": [
        [
          {
            "node": "Escalate uncertain and failed delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escalate uncertain and failed delivery": {
      "main": [
        [
          {
            "node": "Incidents need operator review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Incidents need operator review": {
      "main": [
        [
          {
            "node": "Return reconciliation queue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return clean delivery review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "active": false,
  "tags": []
}
