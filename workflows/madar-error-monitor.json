{
  "name": "MADAR Error Monitor",
  "nodes": [
    {
      "id": "error",
      "name": "Workflow failure",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        160,
        220
      ],
      "parameters": {}
    },
    {
      "id": "summary",
      "name": "Redacted incident summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        220
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json})=>{const clean=v=>String(v||'').replace(/[^a-zA-Z0-9_-]/g,'').slice(0,100); const w=clean(json.workflow?.id),e=clean(json.execution?.id); return {json:{event_id:('failure:'+w+':'+e).slice(0,200),workflow_id:w,execution_id:e,category:'workflow_failure'}};});"
      }
    },
    {
      "id": "record-operator-incident",
      "name": "Record operator incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/bridge/incidents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "MADAR bridge"
        }
      }
    }
  ],
  "connections": {
    "Workflow failure": {
      "main": [
        [
          {
            "node": "Redacted incident summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Redacted incident summary": {
      "main": [
        [
          {
            "node": "Record operator incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "active": false,
  "tags": []
}
