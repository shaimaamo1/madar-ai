{
  "name": "MADAR Ingestion Subworkflow",
  "nodes": [
    {
      "id": "sub",
      "name": "Called by workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        160,
        220
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "validate-normalized-inquiry",
      "name": "Validate normalized inquiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        220
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json})=>{if(!json.event_id||!json.lead?.name||typeof json.text!=='string') throw new Error('Expected normalized event_id, lead and text'); return {json};});"
      }
    },
    {
      "id": "normalize-inquiry",
      "name": "Normalize inquiry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/integrations/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "MADAR ingestion"
        }
      }
    }
  ],
  "connections": {
    "Called by workflow": {
      "main": [
        [
          {
            "node": "Validate normalized inquiry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate normalized inquiry": {
      "main": [
        [
          {
            "node": "Normalize inquiry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "active": false,
  "tags": []
}
