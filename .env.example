# Local development uses a generated private administrator password and demo workspaces.
MADAR_ENV=development
MADAR_DEMO_MODE=true
MADAR_DB_PATH=./var/madar.sqlite3
MADAR_PUBLIC_URL=http://localhost:8000
# For production: disable demo, use HTTPS, and securely inject an initial admin password.
# MADAR_ADMIN_PASSWORD=
# MADAR_ADMIN_EMAIL=owner@example.com
# Optional real language model; otherwise the clearly labeled rules assistant operates.
# MADAR_AI_API_KEY=
MADAR_AI_MODEL=gpt-4.1-mini
MADAR_ALLOW_MODEL_USAGE=false
# All external integrations are restricted to this single configured tenant.
# MADAR_INTEGRATION_TENANT_ID=
# Resolve the generated tenant ID from its slug in local development.
MADAR_INTEGRATION_WORKSPACE=madar
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_CONTAINER_URL=http://n8n:5678
# URL used by n8n containers to reach MADAR; different from browser localhost.
MADAR_N8N_APP_URL=http://app:8000
# N8N_API_KEY=
# MADAR_BRIDGE_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# MADAR_INGEST_TOKEN=
# Only for the optional NEW Compose n8n instance; preserve existing n8n encryption keys.
# N8N_ENCRYPTION_KEY=
# Optional explicit hostnames for a forwarded Vite Web Preview (comma-separated).
# MADAR_PREVIEW_HOSTS=
# Real external delivery remains disabled until the owner explicitly approves it.
MADAR_ALLOW_EXTERNAL_SEND=false
# Prefer the dashboard Settings > Telegram setup for private persistent configuration.
MADAR_ALLOW_TELEGRAM_SEND=false
